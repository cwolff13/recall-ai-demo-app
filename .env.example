# Recall resources are region-specific. Keep these values in one region.
RECALL_REGION=us-west-2
RECALL_API_KEY=
RECALL_WORKSPACE_VERIFICATION_SECRET=

# Stable HTTPS URL that forwards to this server.
PUBLIC_API_BASE_URL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini

# Optional. Defaults to 3000.
PORT=3000
